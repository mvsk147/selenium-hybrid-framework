<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Automation Suite" parallel="none">

    <groups>
        <run>
            <include name="smoke"/>
        </run>
    </groups>

    <listeners>
        <listener class-name="com.sai.framework.listeners.TestListener" />
    </listeners>


    <test name="Smoke Tests">

        <classes>

            <class name="com.sai.framework.tests.LoginTest" />
            
        </classes>

    </test>


</suite>