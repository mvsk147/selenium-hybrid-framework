<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Automation Suite" parallel="tests" thread-count="3">

    <groups>
        <run>
            <include name="smoke"/>
        </run>
    </groups>

    <listeners>
        <listener class-name="com.sai.framework.listeners.TestListener" />
    </listeners>


    <test name="Chrome Smoke Tests">
        
        <parameter name="browser" value="chrome" />

        <classes>

            <class name="com.sai.framework.tests.LoginTest" />
            
        </classes>

    </test>

    <test name="Firefox Smoke Tests">

        <parameter name="browser" value="firefox" />

        <classes>

            <class name="com.sai.framework.tests.LoginTest" />

        </classes>

    </test>

    <test name="Edge Smoke Tests">

        <parameter name="browser" value="edge" />

        <classes>

            <class name="com.sai.framework.tests.LoginTest" />

        </classes>

    </test>

</suite>